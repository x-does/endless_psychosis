{
  "name": "endless-psychosis",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/dev.ts",
    "build": "node scripts/build-hostinger.mjs",
    "build:app": "tsc -b && NODE_ENV=production vite build && npm run build:server",
    "build:server": "esbuild server/app.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/app.cjs",
    "start": "node app.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
